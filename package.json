{
    "name": "chess-game-solo",
    "version": "1.0.0",
    "description": "Chess game",
    "workspaces": [
        "client",
        "game-engine",
        "server",
        "shared"
    ],
    "scripts": {
        "start": "cd ./client && npm start",
        "start:server": "cd ./server && npm start",
        "test": "jest && cd server && npm test",
        "test:game-engine": "cd ./game-engine && npm test",
        "test:server": "cd ./server && npm test",
        "test:client": "cd ./client && npm test",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci && cd server && npm run test:ci",
        "test:coverage": "jest --coverage && cd server && npm run test:coverage",
        "build:engine": "cd ./game-engine && npm run build",
        "build": "sh scripts/build.sh",
        "cleanup": "sh scripts/cleanup.sh",
        "deploy": "sh scripts/deploy.sh"
    },
    "keywords": [
        "chess",
        "typescript",
        "unit-tests"
    ],
    "author": "mterczynski",
    "license": "MIT",
    "dependencies": {
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "jsonwebtoken": "^9.0.3",
        "lodash": "^4.18.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "typescript": "5.9.3"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.24",
        "jest": "^30.3.0",
        "ts-jest": "^29.4.6"
    }
}
