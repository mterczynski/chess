{
    "name": "chess-game-solo",
    "version": "1.0.0",
    "description": "Chess game",
    "workspaces": [
        "client",
        "game-engine",
        "server",
        "shared"
    ],
    "scripts": {
        "start": "npm start -w client",
        "start:server": "npm start -w server",
        "test": "jest && npm test -w server",
        "test:game-engine": "npm test -w game-engine",
        "test:server": "npm test -w server",
        "test:client": "npm test -w client",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci && npm test -w server",
        "test:coverage": "jest --coverage",
        "build:engine": "npm run build -w game-engine",
        "build": "sh scripts/build.sh",
        "cleanup": "sh scripts/cleanup.sh",
        "deploy": "sh scripts/deploy.sh"
    },
    "keywords": [
        "chess",
        "typescript",
        "unit-tests"
    ],
    "author": "mterczynski",
    "license": "MIT",
    "dependencies": {
        "@emotion/is-prop-valid": "^1.4.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "jsonwebtoken": "^9.0.3",
        "lodash": "^4.18.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "stylis": "^4.4.0",
        "typescript": "5.9.3"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.24",
        "jest": "^30.4.2",
        "ts-jest": "^29.4.11"
    }
}
